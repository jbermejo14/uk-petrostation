# Fuel Finder API Configuration (OAuth 2.0)
# Register and generate credentials via GOV.UK One Login:
# https://www.gov.uk/guidance/access-the-latest-fuel-prices-and-forecourt-data-via-api-or-email
FUEL_FINDER_CLIENT_ID=your_client_id_here
FUEL_FINDER_CLIENT_SECRET=your_client_secret_here
FUEL_FINDER_ENVIRONMENT=production # Options: "production" or "test"

# Alternative: Ingest from official Fuel Finder CSV extract
# Can be a local filesystem path or remote URL:
# FUEL_FINDER_CSV_PATH=./data/fuel_finder_latest.csv
# FUEL_FINDER_CSV_URL=https://raw.githubusercontent.com/matthewgall/fuelfinder-archive/main/data.csv
